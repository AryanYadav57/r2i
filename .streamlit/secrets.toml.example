# Copy this file to secrets.toml and add your restricted Google Maps keys.
# For local testing, one key may be used for both APIs if it is configured
# for Routes API and Maps JavaScript API.
google_maps_api_key = "YOUR_GOOGLE_MAPS_API_KEY"

# Optional Qualcomm Imagine assistant; leave unset to disable AI explanations.
inference_cloud_api_key = "YOUR_INFERENCE_CLOUD_API_KEY"
inference_cloud_endpoint = "https://aisuite.cirrascale.com/apis/v2"
inference_cloud_model = "Llama-3.1-8B"

# Recommended for deployment: restrict the browser key by HTTP referrer and
# the server key by server IP, then set these separately instead.
# google_maps_browser_api_key = "YOUR_BROWSER_RESTRICTED_KEY"
# google_maps_server_api_key = "YOUR_SERVER_RESTRICTED_KEY"
