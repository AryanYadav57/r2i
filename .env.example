# Copy to .env (git-ignored) and fill in what you use. Real environment variables override it.

# Ask AI via Qualcomm AI Playground / Cirrascale Inference Cloud (OpenAI-compatible)
INFERENCE_CLOUD_API_KEY=
INFERENCE_CLOUD_ENDPOINT=https://aisuite.cirrascale.com/apis/v2
INFERENCE_CLOUD_MODEL=Llama-3.3-70B

# Fallback: Ask AI via Claude (used only when INFERENCE_CLOUD_API_KEY is empty)
ANTHROPIC_API_KEY=

# Place search via Google Geocoding (needs billing enabled); OSM Nominatim is used otherwise
GOOGLE_MAPS_API_KEY=

# Comma-separated origins allowed to call the API (your deployed web app)
R2I_CORS=http://localhost:5173,http://localhost:4173
